{
    "name": "uk-hse-enforcement-monitor",
    "version": "2.0.1",
    "type": "module",
    "description": "UK HSE Enforcement Monitor: scrape and monitor the Health and Safety Executive public registers of convictions (prosecutions, fines, breaches, courts) and enforcement notices (Improvement and Prohibition notices) on resources.hse.gov.uk - server-side filters, delta mode with NEW/UPDATED events, ISO dates, numeric GBP, defendant status and repeat-offender signals.",
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "cheerio": "1.0.0-rc.12"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:live": "cross-env LIVE=1 vitest run"
    },
    "author": "Stefano",
    "license": "Apache-2.0",
    "keywords": [
        "apify",
        "actor",
        "hse",
        "health and safety executive",
        "uk health and safety prosecutions",
        "hse enforcement notices",
        "improvement notice",
        "prohibition notice",
        "hse convictions register",
        "contractor vetting",
        "kyb",
        "adverse media",
        "osha equivalent uk",
        "scraper",
        "monitor",
        "delta",
        "b2b data"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/stefanoseggio/uk-hse-enforcement-monitor.git"
    },
    "homepage": "https://apify.com/stefano_seggio/uk-hse-enforcement-monitor"
}
